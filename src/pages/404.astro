---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/amiri/400.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '../styles/global.css';
import { site } from '../data/site';
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | {site.name.en}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body style="padding-bottom: 0;">
    <main class="section">
      <div class="wrap narrow">
        <span class="monogram" aria-hidden="true">AH</span>
        <h1 style="margin-top: 2rem;">Page not found</h1>
        <p class="lead">The page you are looking for does not exist or has moved.</p>
        <p><a class="btn btn-primary" href="/en/">Go to the homepage</a></p>
        <div lang="ar" dir="rtl" style="margin-top: 4rem; border-top: 1px solid var(--line); padding-top: 3rem;">
          <h2>الصفحة غير موجودة</h2>
          <p class="lead">الصفحة التي تبحث عنها غير موجودة أو نُقلت إلى عنوان آخر.</p>
          <p><a class="btn btn-primary" href="/ar/">الذهاب إلى الصفحة الرئيسية</a></p>
        </div>
      </div>
    </main>
  </body>
</html>
