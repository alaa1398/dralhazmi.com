---
// Entry page: sends visitors to Arabic if their browser prefers it, otherwise English.
import { DRAFT } from '../data/site';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dr. Alaa Alhazmi | د. علاء الحازمي</title>
    <meta name="description" content="Dr. Alaa Alhazmi, consultant in bariatric, metabolic, robotic and general surgery. د. علاء الحازمي، استشاري جراحة السمنة والجراحة الأيضية والروبوتية والعامة." />
    {DRAFT && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href="https://dralhazmi.com/" />
    <link rel="alternate" hreflang="en" href="https://dralhazmi.com/en/" />
    <link rel="alternate" hreflang="ar" href="https://dralhazmi.com/ar/" />
    <link rel="alternate" hreflang="x-default" href="https://dralhazmi.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dralhazmi.com/" />
    <meta property="og:title" content="Dr. Alaa Alhazmi | د. علاء الحازمي" />
    <meta property="og:description" content="Bariatric, metabolic, robotic and general surgery. جراحة السمنة والجراحة الأيضية والروبوتية والعامة." />
    <meta property="og:image" content="https://dralhazmi.com/images/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      var langs = navigator.languages || [navigator.language || ''];
      var ar = langs.some(function (l) { return /^ar\b/i.test(l); });
      location.replace(ar ? '/ar/' : '/en/');
    </script>
  </head>
  <body style="font-family: system-ui, sans-serif; text-align: center; padding: 3rem 1rem;">
    <p><a href="/en/">English</a> · <a href="/ar/" lang="ar">العربية</a></p>
  </body>
</html>
