---
import PageHero from '../../../components/PageHero.astro';
import TreatmentList from '../../../components/TreatmentList.astro';
import ContactBox from '../../../components/ContactBox.astro';
import Base from '../../../layouts/Base.astro';
import { langs, treatments, asmbsSource, ui, type Lang, risksNote, robotPoints, nav } from '../../../data/site';
export function getStaticPaths() {
  return langs.flatMap((lang) => treatments.map((t) => ({ params: { lang, slug: t.slug }, props: { t } })));
}
const lang = Astro.params.lang as Lang;
const { t } = Astro.props;
const robotic = t.slug === 'robotic-surgery';

const h = {
  what: { en: 'What it is', ar: 'نبذة عن العلاج' },
  who: { en: 'Who it may suit', ar: 'لمن قد يناسب هذا العلاج؟' },
  expect: { en: 'What to expect', ar: 'ما الذي تتوقعه؟' },
  next: { en: 'Discuss your options', ar: 'تحدّث معنا عن خياراتك العلاجية' },
  sources: { en: 'Source', ar: 'المصدر (بالإنجليزية)' },
  general: {
    en: 'This page is general information, not medical advice for your situation.',
    ar: 'المعلومات في هذه الصفحة عامة، ولا تُغني عن الاستشارة الطبية لحالتك.',
  },
};
---
<Base lang={lang} path={`treatments/${t.slug}`} title={t.name} description={t.summary}>
  <article>
    <PageHero lang={lang} path={`treatments/${t.slug}`} title={t.name} lead={t.summary} parent={nav[2]} arcs={robotic}>
      {robotic && (
        <ul class="facts4" slot="below">
          {robotPoints.map((p) => <li><h2>{p.t[lang]}</h2><p>{p.d[lang]}</p></li>)}
        </ul>
      )}
    </PageHero>
    <div class="chapters">
      <div class="wrap">
        {(['what', 'who', 'expect'] as const).map((k, i) => (
          <section class="chapter" aria-labelledby={`ch-${k}`}>
            <div class="ch-side"><p class="label ch-no num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p><h2 id={`ch-${k}`}>{h[k][lang]}</h2></div>
            <div class="ch-body"><p>{t[k][lang]}</p></div>
          </section>
        ))}
      </div>
    </div>
    <ContactBox lang={lang} title={h.next} topic={t.name[lang]}>
      <p class="small">{h.general[lang]}</p>
      <p class="small"><time datetime="2026-11">{ui.reviewed[lang]}</time></p>
      {t.slug === 'bariatric-surgery' && (
        <p class="small prose">{h.sources[lang]}: <a href={asmbsSource.url} lang="en" dir="ltr">{asmbsSource.label}</a></p>
      )}
    </ContactBox>
  </article>
  <section class="sec sec-sand" aria-labelledby="more-h">
    <div class="wrap">
      <div class="sec-head label"><h2 class="lbl" id="more-h">{nav[2].label[lang]}</h2></div>
      <TreatmentList lang={lang} items={treatments.filter((o) => o.slug !== t.slug)} />
      <div class="risk-row"><div class="callout"><p>{risksNote[lang]}</p></div></div>
    </div>
  </section>
</Base>
