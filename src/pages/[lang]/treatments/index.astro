---
import Base from '../../../layouts/Base.astro';
import { langPaths, treatments, type Lang } from '../../../data/site';
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;

const c = {
  title: { en: 'Treatments', ar: 'العلاجات' },
  description: {
    en: 'Bariatric, metabolic, robotic and general surgery, and obesity medicine with Dr. Alaa Alhazmi.',
    ar: 'جراحات السمنة والجراحة الأيضية والروبوتية والجراحة العامة وطب السمنة مع د. علاء الحازمي.',
  },
  intro: {
    en: 'Every plan starts with a full assessment. These pages explain each treatment in general terms; your options are discussed at your consultation.',
    ar: 'تبدأ كل خطة علاجية بتقييم شامل لحالتك. وتقدّم هذه الصفحات تعريفًا عامًا بكل علاج، أما خياراتك فتُناقَش خلال الاستشارة.',
  },
};
---
<Base lang={lang} path="treatments" title={c.title} description={c.description}>
  <section class="section">
    <div class="wrap">
      <h1>{c.title[lang]}</h1>
      <p class="lead">{c.intro[lang]}</p>
      <div class="t-list" style="margin-top: 3rem;">
        {treatments.map((t, i) => (
          <a class="t-row" href={`/${lang}/treatments/${t.slug}/`}>
            <span class="t-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="t-name">{t.name[lang]}</span>
            <span class="t-desc">{t.summary[lang]}</span>
            <span class="t-arrow" aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
