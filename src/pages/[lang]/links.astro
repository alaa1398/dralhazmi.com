---
// Link-in-bio page: dralhazmi.com/en/links/ and /ar/links/
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/dr-alaa-alhazmi.jpg';
import { langPaths, site, social, phone, ui, faisalNote, type Lang } from '../../data/site';
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;

const c = {
  title: { en: 'Links', ar: 'الروابط' },
  description: {
    en: 'All official accounts and contact links for Dr. Alaa Alhazmi.',
    ar: 'جميع الحسابات الرسمية وروابط التواصل للدكتور علاء الحازمي.',
  },
  website: { en: 'Website', ar: 'الموقع الإلكتروني' },
};
---
<Base lang={lang} path="links" title={c.title} description={c.description}>
  <section class="sec" style="padding-block-start: clamp(2.5rem, 6vw, 5rem);">
    <div class="wrap links-page">
      <div class="links-head">
        <Image src={portrait} alt="" width={240} height={240} fit="cover" position="top" widths={[120, 240]} sizes="120px" loading="eager" quality={72} />
        <h1>{site.name[lang]}</h1>
        <p class="small">{site.title[lang]}</p>
        <p class="cred" dir="ltr" lang="en" style="text-align: center;">{site.credentials}</p>
      </div>
      <ul class="link-rows">
        <li><a href={`/${lang}/`}><span class="ln">{c.website[lang]}</span><span class="lh" lang="en" dir="ltr">dralhazmi.com</span></a></li>
        <li><a href={phone.tel}><span class="ln">{ui.call[lang]}</span><span class="lh"><bdi dir="ltr" class="num">{phone.intl}</bdi></span></a></li>
        {social.map((s) => <li><a href={s.url}><span class="ln" lang="en" dir="ltr">{s.name}</span><span class="lh"><bdi dir="ltr" lang="en">{s.handle}</bdi></span></a></li>)}
      </ul>
      <p class="small" style="margin-block-start: 1.5rem;">{faisalNote[lang]}</p>
    </div>
  </section>
</Base>
