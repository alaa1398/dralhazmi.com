---
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { langPaths, social, ui, type Lang } from '../../data/site';
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;

const c = {
  title: { en: 'Learn', ar: 'تثقيف' },
  description: {
    en: 'Videos and articles about obesity, bariatric and metabolic surgery, and robotic surgery by Dr. Alaa Alhazmi.',
    ar: 'مقاطع ومقالات عن السمنة وجراحات السمنة والجراحة الأيضية والروبوتية من د. علاء الحازمي.',
  },
  intro: {
    en: 'Short, practical videos about obesity, surgery and recovery. Follow along on your favorite platform.',
    ar: 'مقاطع قصيرة وعملية عن السمنة والجراحة والتعافي. تابعنا على منصتك المفضلة.',
  },
  resourcesText: {
    en: 'Looking for in-depth reading? See patient and professional education from medical societies.',
    ar: 'تبحث عن قراءة أعمق؟ اطّلع على مصادر تثقيفية للمرضى وللممارسين الصحيين من الجمعيات الطبية.',
  },
  soon: {
    en: 'A library of selected videos and articles will appear here.',
    ar: 'ستظهر هنا مكتبة من المقاطع والمقالات المختارة.',
  },
};
const channels = social.filter((s) => ['YouTube', 'TikTok', 'Snapchat', 'Instagram'].includes(s.name));
---
<Base lang={lang} path="media" title={c.title} description={c.description}>
  <PageHero lang={lang} path="media" title={c.title} lead={c.intro} />
  <section class="sec">
    <div class="wrap grid">
      <div style="max-inline-size: 46rem;">
        <ul class="link-rows">
          {channels.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener"><span class="ln" lang="en" dir="ltr">{s.name}</span><span class="lh"><bdi dir="ltr" lang="en">{s.handle}</bdi><span class="vh"> ({ui.newTab[lang]})</span></span></a></li>
          ))}
        </ul>
        <p class="small" style="margin-block-start: 1.5rem;">{c.soon[lang]}</p>
        <div class="callout" style="margin-block-start: 3rem;">
          <p>{c.resourcesText[lang]}</p>
          <p><a class="tlink more" href={`/${lang}/resources/`}>{ui.resources[lang]} <span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></a></p>
        </div>
      </div>
    </div>
  </section>
</Base>
