---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/dr-alaa-alhazmi.jpg';
import { langPaths, site, phone, social, ui, treatments, whatsappLink, whatsappMessages, type Lang } from '../../data/site';
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;

// Robotic surgery leads the treatment list on the homepage.
const ordered = [...treatments].sort((a, b) => Number(b.slug === 'robotic-surgery') - Number(a.slug === 'robotic-surgery'));

const c = {
  title: { en: 'Home', ar: 'الرئيسية' },
  description: {
    en: 'Dr. Alaa Alhazmi, consultant in bariatric, metabolic, robotic and general surgery and obesity medicine. Contact +966 50 970 4040.',
    ar: 'د. علاء الحازمي، استشاري جراحة السمنة والجراحة الأيضية والروبوتية والجراحة العامة وطب السمنة. للتواصل ‎+966 50 970 4040.',
  },
  eyebrow: { en: 'Consultant surgeon · Riyadh', ar: 'استشاري جراحة · الرياض' },
  h1a: { en: 'Precision surgery,', ar: 'جراحة دقيقة،' },
  h1b: { en: 'guided by robotics.', ar: 'بمساعدة الروبوت.' },
  intro: {
    en: 'More than 15 years in bariatric, metabolic and general surgery; in recent years, nearly all operations robotic.',
    ar: 'خبرة تتجاوز خمسة عشر عامًا في جراحة السمنة والجراحة الأيضية والجراحة العامة، وفي السنوات الأخيرة أُجريت العمليات كلها تقريبًا بالروبوت.',
  },
  orCall: { en: 'or call', ar: 'أو اتصل على' },
  stats: [
    { v: '15+', word: false, l: { en: 'years of surgical experience', ar: 'عامًا من الخبرة الجراحية' } },
    { v: '2', word: false, l: { en: 'American Boards: Surgery and Obesity Medicine', ar: 'من شهادات البورد الأمريكي: الجراحة وطب السمنة' } },
    { v: 'FACS', word: false, l: { en: 'Fellow, American College of Surgeons', ar: 'زميل الكلية الأمريكية للجرّاحين' } },
  ],
  quote: {
    en: '“Every patient deserves time to understand all of their options, surgical and non-surgical, before any decision is made.”',
    ar: '«من حق كل مريض أن ينال الوقت الكافي لفهم خياراته كلها، الجراحية وغير الجراحية، قبل اتخاذ أي قرار.»',
  },
  robotH2a: { en: 'The surgeon’s hands,', ar: 'مهارة الجرّاح،' },
  robotH2b: { en: 'with a robot’s steadiness.', ar: 'وثبات الروبوت.' },
  robotText: {
    en: 'In robotic surgery, the surgeon controls fine, wristed instruments and a magnified 3D camera from a console, working through small incisions.',
    ar: 'في الجراحة الروبوتية، يتحكّم الجرّاح من وحدة تحكّم بأدوات دقيقة تنثني وتدور، وبكاميرا تعرض صورة مكبّرة ثلاثية الأبعاد، ويعمل من خلال فتحات صغيرة.',
  },
  robotPoints: [
    { t: { en: 'Magnified 3D view', ar: 'رؤية مكبّرة ثلاثية الأبعاد' }, d: { en: 'A high-definition, three-dimensional image of the operating field.', ar: 'صورة عالية الوضوح لموضع العملية بأبعادها الثلاثة.' } },
    { t: { en: 'Wristed instruments', ar: 'أدوات مرنة الحركة' }, d: { en: 'Instruments that bend and rotate for fine, controlled movement.', ar: 'أدوات تنثني وتدور لتتيح حركة دقيقة ومحكمة.' } },
    { t: { en: 'Small incisions', ar: 'فتحات صغيرة' }, d: { en: 'Minimally invasive access instead of one large opening.', ar: 'جراحة عبر فتحات صغيرة بدل شقّ جراحي كبير.' } },
    { t: { en: 'Established operations', ar: 'عمليات راسخة' }, d: { en: 'Sleeve, bypass, hernia and gallbladder surgery, done robotically.', ar: 'تكميم المعدة وتحويل المسار والفتق والمرارة، تُجرى بالروبوت.' } },
  ],
  pathsEyebrow: { en: 'Two paths to treatment', ar: 'مساران للعلاج' },
  pathsH2a: { en: 'Not every patient', ar: 'ليس كل مريض' },
  pathsH2b: { en: 'needs surgery.', ar: 'بحاجة إلى جراحة.' },
  pathsText: {
    en: 'Certified in both surgery and obesity medicine, Dr. Alhazmi can build a plan around an operation, medical treatment, or both. The right path is decided after a full assessment.',
    ar: 'د. علاء الحازمي حاصل على البورد الأمريكي في الجراحة وفي طب السمنة، لذا قد تشمل خطتك عملية جراحية أو علاجًا طبيًا أو كليهما. ويُحدَّد المسار الأنسب لك بعد تقييم شامل.',
  },
  paths: [
    { t: { en: 'Without surgery', ar: 'دون جراحة' }, items: [
      { en: 'Medical assessment and tests', ar: 'تقييم طبي وفحوصات' },
      { en: 'Nutrition and activity plan', ar: 'خطة للتغذية والنشاط البدني' },
      { en: 'Anti-obesity medicines when suitable', ar: 'أدوية علاج السمنة عند الحاجة' },
      { en: 'Regular follow-up', ar: 'متابعة منتظمة' },
    ] },
    { t: { en: 'With surgery', ar: 'بالجراحة' }, items: [
      { en: 'Sleeve gastrectomy or gastric bypass', ar: 'تكميم المعدة أو تحويل المسار' },
      { en: 'Metabolic surgery for type 2 diabetes', ar: 'الجراحة الأيضية لعلاج السكري من النوع الثاني' },
      { en: 'Revision of a previous operation', ar: 'تصحيح عملية سابقة' },
      { en: 'Long-term follow-up', ar: 'متابعة طويلة الأمد' },
    ] },
  ],
  bmiTitle: { en: 'Am I a candidate?', ar: 'هل أنا مرشّح للعلاج؟' },
  bmiIntro: { en: 'Enter your height and weight to see where you stand under international guidelines.', ar: 'أدخل طولك ووزنك لتعرف موقعك وفق الإرشادات الدولية.' },
  height: { en: 'Height (cm)', ar: 'الطول (سم)' },
  weight: { en: 'Weight (kg)', ar: 'الوزن (كجم)' },
  yourBmi: { en: 'Your BMI', ar: 'مؤشر كتلة الجسم لديك' },
  bmiEmpty: { en: 'Your result will appear here.', ar: 'ستظهر النتيجة هنا.' },
  bmiCta: { en: 'Discuss your result on WhatsApp', ar: 'ناقش نتيجتك عبر واتساب' },
  bmiNote: {
    en: 'For education only, not a diagnosis; a full assessment decides your treatment. Based on the 2022 ASMBS/IFSO guidelines; lower thresholds apply to people of Asian descent.',
    ar: 'للتثقيف فقط، وليست تشخيصًا؛ فالعلاج المناسب يُحدَّد بعد تقييم شامل. تستند النتيجة إلى إرشادات ASMBS/IFSO لعام 2022، وتنطبق حدود أقل على ذوي الأصول الآسيوية.',
  },
  advice: {
    en: [
      'Guidelines recommend weight-loss surgery at this BMI. Medical treatment is also an option; an assessment shows which suits you.',
      'Surgery may be considered, especially with type 2 diabetes or another metabolic disease. Medical treatment is often the first step.',
      'Medical treatment (nutrition, activity and, when suitable, medicines) is usually the first option.',
      'Your BMI is below the overweight range. A medical assessment can still help if you have concerns.',
    ],
    ar: [
      'توصي الإرشادات بجراحة السمنة عند هذا المؤشر، والعلاج الطبي خيار متاح أيضًا، ويبيّن التقييم أيهما أنسب لك.',
      'يمكن النظر في الجراحة، خاصة مع السكري من النوع الثاني أو مرض أيضي آخر، وكثيرًا ما يبدأ العلاج بالخيار الطبي.',
      'العلاج الطبي (التغذية والنشاط البدني، والأدوية عند الحاجة) هو الخيار الأول عادةً.',
      'مؤشرك أقل من نطاق زيادة الوزن، ويمكن للتقييم الطبي أن يفيدك إن كانت لديك مخاوف.',
    ],
  },
  treatments: { en: 'Treatments', ar: 'العلاجات' },
  treatmentsText: { en: 'Surgical and medical care for obesity and common abdominal conditions.', ar: 'رعاية جراحية وطبية للسمنة وأمراض البطن الشائعة.' },
  risks: {
    en: 'Every operation carries risks, including bleeding, infection, leaks and nutritional deficiencies, which are discussed in full before any decision. Long-term follow-up is essential: missing follow-up visits raises the risk of complications. Recovery times vary from person to person.',
    ar: 'لكل عملية جراحية مخاطر محتملة، منها النزيف والعدوى والتسرّب ونقص بعض العناصر الغذائية، وتُناقَش جميعها بالتفصيل قبل اتخاذ أي قرار. والمتابعة طويلة الأمد ضرورية، فالتخلّف عن زيارات المتابعة يزيد خطر المضاعفات. وتختلف مدة التعافي من شخص لآخر.',
  },
  journeyH2: { en: 'From first message to long-term follow-up.', ar: 'من رسالتك الأولى إلى المتابعة طويلة الأمد.' },
  journey: [
    { t: { en: 'Send a message', ar: 'أرسل رسالة' }, d: { en: 'Reach us on WhatsApp or by phone with your question.', ar: 'تواصل معنا عبر واتساب أو الهاتف بسؤالك.' } },
    { t: { en: 'Full assessment', ar: 'تقييم شامل' }, d: { en: 'A consultation, the tests you need, and input from the nutrition team.', ar: 'استشارة، والفحوصات اللازمة، وتقييم من فريق التغذية.' } },
    { t: { en: 'Your treatment', ar: 'العلاج' }, d: { en: 'A medical plan, or preparation followed by an operation and a short hospital stay.', ar: 'خطة علاج طبية، أو تهيئة ثم جراحة وإقامة قصيرة في المستشفى.' } },
    { t: { en: 'Long-term follow-up', ar: 'متابعة طويلة الأمد' }, d: { en: 'Ongoing support on diet, vitamins, activity and medicines.', ar: 'دعم متواصل في التغذية والفيتامينات والنشاط البدني والأدوية.' } },
  ],
  journeyLink: { en: 'Your journey in detail →', ar: 'رحلتك العلاجية بالتفصيل ←' },
  aboutEyebrow: { en: 'About', ar: 'عن الدكتور' },
  aboutText: {
    en: 'Dr. Alhazmi earned an MD at The George Washington University and completed a fellowship in minimally invasive and bariatric surgery at UC Davis. Dr. Alhazmi is certified by the American Board of Surgery and the American Board of Obesity Medicine, and practiced for more than 15 years as a consultant at King Faisal Specialist Hospital & Research Centre in Riyadh.',
    ar: 'حصل د. علاء الحازمي على شهادة الطب من جامعة جورج واشنطن، وأتمّ زمالة جراحة المناظير وجراحة السمنة في جامعة كاليفورنيا ديفيس. وهو حاصل على البورد الأمريكي للجراحة والبورد الأمريكي لطب السمنة، وعمل استشاريًا لأكثر من خمسة عشر عامًا في مستشفى الملك فيصل التخصصي ومركز الأبحاث بالرياض.',
  },
  aboutLink: { en: 'Read the full story →', ar: 'اقرأ المزيد ←' },
  facts: [
    { k: { en: 'Education', ar: 'التعليم' }, v: { en: 'MD, The George Washington University', ar: 'دكتوراه في الطب، جامعة جورج واشنطن' } },
    { k: { en: 'Fellowship', ar: 'الزمالة' }, v: { en: 'Minimally invasive and bariatric surgery, UC Davis', ar: 'جراحة المناظير وجراحة السمنة، جامعة كاليفورنيا ديفيس' } },
    { k: { en: 'Certification', ar: 'الشهادات' }, v: { en: 'American Board of Surgery · American Board of Obesity Medicine · Fellow, American College of Surgeons', ar: 'البورد الأمريكي للجراحة · البورد الأمريكي لطب السمنة · زميل الكلية الأمريكية للجرّاحين' } },
  ],
  faqH2a: { en: 'Common', ar: 'أسئلة' },
  faqH2b: { en: 'questions', ar: 'شائعة' },
  faq: [
    { q: { en: 'Is robotic surgery different from laparoscopic surgery?', ar: 'ما الفرق بين الجراحة الروبوتية وجراحة المنظار؟' }, a: { en: 'Both use small incisions. In robotic surgery the surgeon operates the instruments from a console, with a magnified 3D view and wristed instruments. Which approach suits you is discussed at your consultation.', ar: 'كلتاهما تُجرى عبر فتحات صغيرة. وفي الجراحة الروبوتية يحرّك الجرّاح الأدوات من وحدة تحكّم، مع رؤية مكبّرة ثلاثية الأبعاد وأدوات مرنة الحركة. ويُناقَش الأنسب لحالتك خلال الاستشارة.' } },
    { q: { en: 'Am I a candidate for weight-loss surgery?', ar: 'هل أنا مرشّح لعملية إنقاص الوزن؟' }, a: { en: 'The 2022 ASMBS/IFSO guidelines recommend surgery for adults with a BMI of 35 or more, and considering it from 30 with metabolic disease. The decision is made only after a full assessment.', ar: 'توصي الإرشادات الدولية لعام 2022 (ASMBS/IFSO) بالجراحة للبالغين إذا بلغ مؤشر كتلة الجسم 35 أو أكثر، وبالنظر فيها ابتداءً من 30 عند وجود مرض أيضي. ولا يُتّخذ القرار إلا بعد تقييم شامل.' } },
    { q: { en: 'What are the risks of weight-loss surgery?', ar: 'ما مخاطر عمليات السمنة؟' }, a: { en: 'As with any major operation, risks include bleeding, infection, a leak where the stomach or bowel is joined, and blood clots. Later problems can include vitamin and mineral deficiencies, gallstones, narrowing at the join (stricture) and hernias. In a large study of 209,116 patients cited by ASMBS, the risk of death was 0.16%, about 1 in 600. NIDDK reports that about one-third of patients need a follow-up procedure or hospital stay within 5 years. Your own risk depends on your health and the operation, and is reviewed with you before any decision.', ar: 'كأي عملية كبرى، تشمل المخاطر النزيف والعدوى وتسرّبًا من موضع توصيل المعدة أو الأمعاء وتجلّط الدم. وقد تظهر لاحقًا مشكلات مثل نقص الفيتامينات والمعادن وحصوات المرارة وتضيّق موضع التوصيل والفتق. وفي دراسة كبيرة شملت 209,116 مريضًا تستشهد بها الجمعية الأمريكية لجراحة السمنة والأيض، بلغت نسبة الوفاة 0.16%، أي نحو حالة واحدة من كل 600. ويشير المعهد الوطني الأمريكي للسكري وأمراض الجهاز الهضمي والكلى إلى أن نحو ثلث المرضى يحتاجون إلى إجراء إضافي أو تنويم خلال 5 سنوات. وتعتمد المخاطر في حالتك على صحتك ونوع العملية، وتُناقَش معك قبل اتخاذ أي قرار.' }, links: [{ url: 'https://www.niddk.nih.gov/health-information/weight-management/bariatric-surgery/side-effects', label: { en: 'Source: NIDDK (U.S. National Institutes of Health), Weight-loss surgery side effects', ar: 'المصدر: المعهد الوطني الأمريكي للسكري وأمراض الجهاز الهضمي والكلى، الآثار الجانبية لجراحة السمنة (بالإنجليزية)' } }, { url: 'https://asmbs.org/patients/faqs-of-bariatric-surgery', label: { en: 'Source: ASMBS, FAQs of bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، أسئلة شائعة عن جراحة السمنة (بالإنجليزية)' } }] },
    { q: { en: 'How much weight will I lose?', ar: 'كم سأفقد من وزني؟' }, a: { en: 'It depends on the operation and on you. ASMBS reports that more than 95% of patients lose half or more of their excess weight, and that gastric bypass patients lose about 70% of their excess weight on average, then regain about 5% of it after 2 years or more. Results vary from person to person and cannot be guaranteed.', ar: 'يعتمد ذلك على نوع العملية وعلى حالتك. وتذكر الجمعية الأمريكية لجراحة السمنة والأيض أن أكثر من 95% من المرضى يفقدون نصف وزنهم الزائد أو أكثر، وأن مرضى تحويل المسار يفقدون في المتوسط نحو 70% من وزنهم الزائد، ثم يستعيدون نحو 5% منه بعد سنتين أو أكثر. وتختلف النتائج من شخص لآخر ولا يمكن ضمانها.' }, links: [{ url: 'https://asmbs.org/patients/faqs-of-bariatric-surgery', label: { en: 'Source: ASMBS, FAQs of bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، أسئلة شائعة عن جراحة السمنة (بالإنجليزية)' } }] },
    { q: { en: 'Are weight-loss medications an alternative to surgery?', ar: 'هل تغني أدوية إنقاص الوزن عن العملية؟' }, a: { en: 'Medications such as semaglutide and tirzepatide help many people lose weight, and some patients use them before or after surgery. In a real-world study presented at the 2025 ASMBS annual meeting, patients lost about five times more weight two years after sleeve gastrectomy or gastric bypass than with these injections. Weight often returns when the medication is stopped. The right choice depends on your health, goals and preferences, and both options are discussed at your consultation.', ar: 'تساعد أدوية مثل سيماغلوتايد وتيرزيباتايد كثيرًا من المرضى على إنقاص الوزن، ويستخدمها بعضهم قبل العملية أو بعدها. وفي دراسة واقعية عُرضت في المؤتمر السنوي للجمعية الأمريكية لجراحة السمنة والأيض عام 2025، فقد المرضى بعد سنتين من تكميم المعدة أو تحويل المسار نحو خمسة أضعاف ما فقده مستخدمو هذه الحقن. وغالبًا ما يعود الوزن عند إيقاف الدواء. ويعتمد الخيار الأنسب على صحتك وأهدافك وتفضيلاتك، ويُناقَش الخياران معك خلال الاستشارة.' }, links: [{ url: 'https://asmbs.org/news_releases/head-to-head-study-shows-bariatric-surgery-superior-to-glp-1-drugs-for-weight-loss', label: { en: 'Source: ASMBS news release, June 2025 (study presented at the ASMBS annual meeting)', ar: 'المصدر: بيان صحفي للجمعية الأمريكية لجراحة السمنة والأيض، يونيو 2025 (بالإنجليزية)' } }, { url: 'https://asmbs.org/news_releases/bariatric-surgery-significantly-more-effective-than-glp-1-drugs-for-weight-loss-and-disease-remission-large-real-world-study-finds', label: { en: 'Source: ASMBS news release, May 2026', ar: 'المصدر: بيان صحفي للجمعية الأمريكية لجراحة السمنة والأيض، مايو 2026 (بالإنجليزية)' } }] },
    { q: { en: 'What will I eat after surgery?', ar: 'ماذا سآكل بعد العملية؟' }, a: { en: 'You start on liquids for a few weeks, then move to soft foods and later to solid food, following your team’s plan. ASMBS advises drinking at least 64 ounces (about 1.9 liters) of fluid and eating 60 to 100 grams of protein a day, and limiting foods high in sugar and starch. Many programs also use a special diet for 2 to 3 weeks before surgery to shrink the liver and make the operation safer.', ar: 'تبدأ بالسوائل لبضعة أسابيع، ثم تنتقل إلى الأطعمة اللينة، ثم إلى الطعام الصلب، وفق خطة فريقك الطبي. وتوصي الجمعية الأمريكية لجراحة السمنة والأيض بشرب 1.9 لتر تقريبًا من السوائل يوميًا على الأقل، وتناول 60 إلى 100 غرام من البروتين، والتقليل من الأطعمة الغنية بالسكر والنشويات. وتعتمد برامج كثيرة أيضًا حمية خاصة لمدة أسبوعين إلى ثلاثة أسابيع قبل العملية لتصغير حجم الكبد وجعل العملية أكثر أمانًا.' }, links: [{ url: 'https://asmbs.org/patients/life-after-bariatric-surgery', label: { en: 'Source: ASMBS, Life after bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، الحياة بعد جراحة السمنة (بالإنجليزية)' } }, { url: 'https://asmbs.org/patients/faqs-of-bariatric-surgery', label: { en: 'Source: ASMBS, FAQs of bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، أسئلة شائعة عن جراحة السمنة (بالإنجليزية)' } }] },
    { q: { en: 'Will I need vitamins after surgery?', ar: 'هل سأحتاج إلى الفيتامينات بعد العملية؟' }, a: { en: 'Yes, for life. Supplements usually include a multivitamin, vitamin B12, calcium, vitamin D and iron, with blood tests at least once a year. Skipping them can lead to anemia, bone loss and nerve problems.', ar: 'نعم، مدى الحياة. وتشمل المكمّلات عادةً فيتامينات متعددة وفيتامين ب12 والكالسيوم وفيتامين د والحديد، مع تحاليل دم مرة واحدة سنويًا على الأقل. وقد يؤدي إهمالها إلى فقر الدم وهشاشة العظام واضطرابات الأعصاب.' }, links: [{ url: 'https://asmbs.org/patients/life-after-bariatric-surgery', label: { en: 'Source: ASMBS, Life after bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، الحياة بعد جراحة السمنة (بالإنجليزية)' } }, { url: 'https://asmbs.org/patients/faqs-of-bariatric-surgery', label: { en: 'Source: ASMBS, FAQs of bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، أسئلة شائعة عن جراحة السمنة (بالإنجليزية)' } }] },
    { q: { en: 'When can I return to work and exercise?', ar: 'متى أعود إلى العمل وممارسة الرياضة؟' }, a: { en: 'ASMBS reports that most patients return to work within one to two weeks, depending on the operation and the job. Walking starts within hours of surgery; keep activity low-impact for the first month, then build toward about 30 minutes of moderate exercise a day. Your own timeline is agreed with you before surgery.', ar: 'تذكر الجمعية الأمريكية لجراحة السمنة والأيض أن معظم المرضى يعودون إلى العمل خلال أسبوع إلى أسبوعين، بحسب نوع العملية وطبيعة العمل. ويبدأ المشي خلال ساعات من العملية، مع الاكتفاء بالنشاط الخفيف في الشهر الأول، ثم التدرّج حتى نحو 30 دقيقة من الرياضة المعتدلة يوميًا. ويُتّفق معك على الجدول المناسب لحالتك قبل العملية.' }, links: [{ url: 'https://asmbs.org/patients/faqs-of-bariatric-surgery', label: { en: 'Source: ASMBS, FAQs of bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، أسئلة شائعة عن جراحة السمنة (بالإنجليزية)' } }, { url: 'https://asmbs.org/patients/life-after-bariatric-surgery', label: { en: 'Source: ASMBS, Life after bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، الحياة بعد جراحة السمنة (بالإنجليزية)' } }] },
    { q: { en: 'Will I lose hair after surgery?', ar: 'هل سيتساقط شعري بعد العملية؟' }, a: { en: 'Some hair loss is common 3 to 6 months after surgery and is almost always temporary. Getting enough protein, vitamins and minerals helps it grow back.', ar: 'تساقط بعض الشعر شائع بعد 3 إلى 6 أشهر من العملية، وهو مؤقت في أغلب الحالات. ويساعد الحصول على كفايتك من البروتين والفيتامينات والمعادن على إعادة نموّه.' }, links: [{ url: 'https://asmbs.org/patients/faqs-of-bariatric-surgery', label: { en: 'Source: ASMBS, FAQs of bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، أسئلة شائعة عن جراحة السمنة (بالإنجليزية)' } }] },
    { q: { en: 'When is it safe to become pregnant after surgery?', ar: 'متى يكون الحمل آمنًا بعد العملية؟' }, a: { en: 'Most groups advise waiting 12 to 18 months, while weight loss is fastest and nutrition settles. Fertility often improves after surgery, and birth control pills are less reliable while weight is changing, so plan contraception, such as an IUD, before surgery. Talk to your team before trying to conceive.', ar: 'توصي معظم الجهات بالانتظار 12 إلى 18 شهرًا، وهي الفترة التي يكون فيها نزول الوزن أسرع وتستقر فيها التغذية. وكثيرًا ما تتحسّن الخصوبة بعد العملية، كما تقلّ موثوقية حبوب منع الحمل أثناء تغيّر الوزن، لذا خطّطي لوسيلة منع الحمل، مثل اللولب، قبل العملية. وتحدّثي مع فريقك الطبي قبل محاولة الحمل.' }, links: [{ url: 'https://asmbs.org/patients/faqs-of-bariatric-surgery', label: { en: 'Source: ASMBS, FAQs of bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، أسئلة شائعة عن جراحة السمنة (بالإنجليزية)' } }, { url: 'https://asmbs.org/patients/life-after-bariatric-surgery', label: { en: 'Source: ASMBS, Life after bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، الحياة بعد جراحة السمنة (بالإنجليزية)' } }] },
    { q: { en: 'Can I fast in Ramadan after weight-loss surgery?', ar: 'هل يمكنني صيام رمضان بعد عملية السمنة؟' }, a: { en: 'Published recommendations differ: an international expert consensus advises delaying fasting for about 6 to 12 months after bypass-type (combined or malabsorptive) operations, while some hospital programs, such as the NHS leaflet below, advise 12 to 18 months. Dr. Alhazmi generally recommends waiting 6 to 12 months, depending on the operation and your recovery, because of the risk of dehydration, low blood sugar and nutritional deficiencies. Fasting then needs a plan for fluids, protein and vitamins, and should stop if symptoms of intolerance persist. If your surgery falls close to Ramadan, the timing can be planned with you. Discuss your plan with Dr. Alhazmi before you fast.', ar: 'تختلف التوصيات المنشورة: إذ يوصي إجماع دولي للخبراء بتأجيل الصيام نحو 6 إلى 12 شهرًا بعد عمليات تحويل المسار وما يماثلها، بينما توصي بعض البرامج العلاجية، مثل نشرة هيئة الخدمات الصحية البريطانية أدناه، بتأجيله 12 إلى 18 شهرًا. ويوصي د. علاء الحازمي عادةً بالانتظار 6 إلى 12 شهرًا، بحسب نوع العملية وتعافيك، تجنبًا للجفاف وانخفاض السكر ونقص العناصر الغذائية. ويحتاج الصيام بعد ذلك إلى خطة للسوائل والبروتين والفيتامينات، ويجب التوقف عنه إذا استمرت أعراض عدم التحمّل. وإن كان موعد العملية قريبًا من رمضان، يمكن ترتيب التوقيت معك. ناقش خطتك مع د. علاء الحازمي قبل الصيام.' }, links: [
      { url: 'https://doi.org/10.1007/s11695-021-05724-z', label: { en: 'Religious fasting of Muslim patients after metabolic and bariatric surgery: a modified Delphi consensus', ar: 'إجماع خبراء دولي حول صيام المرضى المسلمين بعد جراحة السمنة (بالإنجليزية)' }, cite: 'Kermansaravi M, et al. Obes Surg. 2021;31(12):5303–5311' },
      { url: 'https://www.chelwest.nhs.uk/your-visit/patient-leaflets/bariatric-dietetics/ramadan-and-fasting-after-bariatric-surgery', label: { en: 'Chelsea and Westminster Hospital NHS Foundation Trust: Ramadan and fasting after bariatric surgery (patient leaflet).', ar: 'مستشفى تشيلسي وويستمنستر (هيئة الخدمات الصحية البريطانية): رمضان والصيام بعد جراحة السمنة، نشرة للمرضى (بالإنجليزية)' } },
    ] },
    { q: { en: 'Can the weight come back, and what follow-up will I need?', ar: 'هل يمكن أن يعود الوزن، وما المتابعة التي سأحتاجها؟' }, a: { en: 'Obesity is a long-term disease, and some weight regain is possible. ASMBS advises visits every few months in the first year, then a yearly review with a bariatric specialist for life. If weight returns, options include lifestyle support, medication and, in some cases, further surgery.', ar: 'السمنة مرض مزمن، وقد يستعيد بعض المرضى جزءًا من الوزن. وتوصي الجمعية الأمريكية لجراحة السمنة والأيض بالمتابعة كل بضعة أشهر في السنة الأولى، ثم بزيارة سنوية مدى الحياة لدى مختص في علاج السمنة. وإن عاد الوزن، فمن الخيارات المتاحة دعم نمط الحياة والأدوية، وفي بعض الحالات عملية إضافية.' }, links: [{ url: 'https://asmbs.org/patients/life-after-bariatric-surgery', label: { en: 'Source: ASMBS, Life after bariatric surgery', ar: 'المصدر: الجمعية الأمريكية لجراحة السمنة والأيض، الحياة بعد جراحة السمنة (بالإنجليزية)' } }] },
    { q: { en: 'Can I get a second opinion on a surgery recommendation?', ar: 'هل يمكنني طلب رأي طبي ثانٍ في توصية بإجراء عملية؟' }, a: { en: 'Yes. Send your question on WhatsApp. If Dr. Alhazmi needs your medical reports, the team will ask for your consent first.', ar: 'نعم. أرسل سؤالك عبر واتساب. وإن احتاج د. علاء الحازمي إلى تقاريرك الطبية، فسيطلب الفريق موافقتك أولًا.' } },
    { q: { en: 'Does health insurance cover weight-loss surgery?', ar: 'هل يغطي التأمين الصحي عمليات السمنة؟' }, a: { en: 'Under the basic health insurance policy set by Saudi Arabia’s Council of Health Insurance (essential benefit package effective October 2022), approved bariatric operations are covered when BMI is above 40, or above 35 with complications, up to SAR 15,000 per policy period, with a copayment of 0–20% capped at SAR 1,000. Coverage depends on your policy and on clinical criteria, so confirm with your insurer before surgery.', ar: 'وفق حزمة المنافع الأساسية لوثيقة الضمان الصحي الصادرة عن مجلس الضمان الصحي (السارية منذ أكتوبر 2022)، تُغطّى عمليات السمنة المعتمدة عند تجاوز مؤشر كتلة الجسم 40، أو 35 مع وجود مضاعفات، بحد أقصى 15,000 ريال خلال مدة الوثيقة، مع نسبة تحمّل من 0 إلى 20% بحد أقصى 1,000 ريال. وتختلف التغطية بحسب وثيقتك والمعايير الطبية، لذا تأكد من شركة التأمين قبل العملية.' }, links: [{ url: 'https://www.chi.gov.sa/en/beneficiary/healthinsurancepolicy/Updated%20Essential%20Benefit%20Package%20%20(%20effective%201%20October%202022).pdf', label: { en: 'Source: Council of Health Insurance, basic health insurance policy (PDF)', ar: 'المصدر: مجلس الضمان الصحي، وثيقة الضمان الصحي الأساسية (PDF، بالإنجليزية)' } }] },
    { q: { en: 'Who answers when I call?', ar: 'من يردّ على اتصالي؟' }, a: { en: 'Calls are answered by Faisal, Dr. Alhazmi’s AI assistant, who can take your message.', ar: 'يردّ فيصل، مساعد الذكاء الاصطناعي للدكتور علاء الحازمي، ويمكنه تسجيل رسالتك.' } },
  ],
  ctaH2a: { en: 'Already advised to', ar: 'هل نُصحت' },
  ctaH2b: { en: 'have surgery?', ar: 'بإجراء عملية؟' },
  ctaText: { en: 'Send your question on WhatsApp for a second opinion from Dr. Alhazmi.', ar: 'أرسل سؤالك عبر واتساب للحصول على رأي طبي ثانٍ من د. علاء الحازمي.' },
  ctaBtn: { en: 'Request a second opinion', ar: 'اطلب رأيًا طبيًا ثانيًا' },
};
const arrow = lang === 'ar' ? '←' : '→';

// Structured data for search engines; mirrors facts shown on the site.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: site.name[lang],
  description: c.description[lang],
  url: `${site.url}/${lang}/`,
  image: `${site.url}/images/dr-alaa-alhazmi.jpg`,
  telephone: phone.tel.replace('tel:', ''),
  knowsAbout: treatments.map((t) => t.name[lang]),
  knowsLanguage: ['en', 'ar'],
  sameAs: social.filter((s) => s.name !== 'WhatsApp').map((s) => s.url),
};
---
<Base lang={lang} path="" title={c.title} description={c.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow intro">{c.eyebrow[lang]}</p>
        <h1 class="intro-2">{c.h1a[lang]}<br /><em class="accent">{c.h1b[lang]}</em></h1>
        <p class="lead intro-3">{c.intro[lang]}</p>
        <div class="btn-row intro-3">
          <a class="btn btn-primary" href={whatsappLink(whatsappMessages.booking[lang])}>{ui.bookWhatsApp[lang]}</a>
          <a class="ulink" href={phone.tel}>{c.orCall[lang]} <bdi dir="ltr">{phone.intl}</bdi></a>
        </div>
      </div>
      <div class="portrait">
        <div class="portrait-frame">
          <Image src={portrait} alt={site.name[lang]} widths={[320, 440, 640, 880]} sizes="(max-width: 899px) 320px, 440px" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </div>
    <div class="wrap">
      <ul class="stats">
        {c.stats.map((s) => (
          <li>
            <p class:list={['stat-value', { word: s.word }]}>{typeof s.v === 'string' ? <bdi dir="ltr">{s.v}</bdi> : s.v[lang]}</p>
            <p class="stat-label">{s.l[lang]}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section reveal">
    <figure class="quote wrap">
      <blockquote>{c.quote[lang]}</blockquote>
      <figcaption class="eyebrow" style="color: var(--muted); margin: 0;">{site.name[lang]}</figcaption>
    </figure>
  </section>

  <section class="section section-dark" id="robotic">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>{c.robotH2a[lang]}<br /><em class="accent">{c.robotH2b[lang]}</em></h2>
        <p>{c.robotText[lang]}</p>
      </div>
      <ol class="points">
        {c.robotPoints.map((p, i) => (
          <li class="reveal">
            <p class="point-num">{String(i + 1).padStart(2, '0')}</p>
            <h3>{p.t[lang]}</h3>
            <p>{p.d[lang]}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="paths">
    <div class="wrap split">
      <div class="main reveal">
        <p class="eyebrow">{c.pathsEyebrow[lang]}</p>
        <h2>{c.pathsH2a[lang]}<br />{c.pathsH2b[lang]}</h2>
        <p class="lead" style="margin-bottom: 2.5rem;">{c.pathsText[lang]}</p>
        <div class="points">
          {c.paths.map((p) => (
            <div>
              <h3 class="serif" style="font-size: 1.6rem; font-weight: 500;">{p.t[lang]}</h3>
              <ul>{p.items.map((x) => <li>{x[lang]}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <div class="side bmi reveal" id="bmi"
        data-advice={JSON.stringify(c.advice[lang])}>
        <h3>{c.bmiTitle[lang]}</h3>
        <p style="color: var(--body);">{c.bmiIntro[lang]}</p>
        <div class="bmi-fields">
          <label>{c.height[lang]}<input id="bmi-h" type="text" inputmode="decimal" placeholder="170" autocomplete="off" /></label>
          <label>{c.weight[lang]}<input id="bmi-w" type="text" inputmode="decimal" placeholder="95" autocomplete="off" /></label>
        </div>
        <div class="bmi-result" aria-live="polite">
          <div id="bmi-out" hidden>
            <p class="small" style="margin: 0;">{c.yourBmi[lang]}</p>
            <p class="bmi-value"><bdi dir="ltr" id="bmi-val"></bdi></p>
            <p id="bmi-advice" style="margin: 0;"></p>
          </div>
          <p id="bmi-empty" class="small" style="margin: 0;">{c.bmiEmpty[lang]}</p>
        </div>
        <a class="btn btn-primary" href={whatsappLink(whatsappMessages.booking[lang])}>{c.bmiCta[lang]}</a>
        <p class="small" style="margin: 0;">{c.bmiNote[lang]}</p>
      </div>
    </div>
  </section>

  <section class="section section-sand" id="treatments">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>{c.treatments[lang]}</h2>
        <p>{c.treatmentsText[lang]}</p>
      </div>
      <div class="t-list">
        {ordered.map((t, i) => (
          <a class="t-row reveal" href={`/${lang}/treatments/${t.slug}/`}>
            <span class="t-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="t-name">{t.name[lang]}</span>
            <span class="t-desc">{t.summary[lang]}</span>
            <span class="t-arrow" aria-hidden="true">{arrow}</span>
          </a>
        ))}
      </div>
      <p class="small" style="margin-top: 2rem; max-width: 56rem;">{c.risks[lang]}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="reveal" style="max-width: 48rem; margin-bottom: 3.5rem;">{c.journeyH2[lang]}</h2>
      <ol class="points">
        {c.journey.map((s, i) => (
          <li class="reveal" style="border-top: none; padding-top: 0;">
            <p class="big-num">{i + 1}</p>
            <h3>{s.t[lang]}</h3>
            <p>{s.d[lang]}</p>
          </li>
        ))}
      </ol>
      <p style="margin-top: 2.5rem;"><a class="ulink" href={`/${lang}/journey/`} style="color: var(--ink); font-weight: 500;">{c.journeyLink[lang]}</a></p>
    </div>
  </section>

  <section class="section section-sand" id="about">
    <div class="wrap split">
      <div class="main reveal" style="flex-basis: 26rem;">
        <p class="eyebrow">{c.aboutEyebrow[lang]}</p>
        <h2 style="margin-bottom: 0.5rem;">{site.name[lang]}</h2>
        <p class="small" dir="ltr" style={`letter-spacing: 0.08em; margin-bottom: 1.5rem;${lang === 'ar' ? ' text-align: right;' : ''}`}>{site.credentials}</p>
        <p style="color: var(--body);">{c.aboutText[lang]}</p>
        <a class="ulink" href={`/${lang}/about/`} style="color: var(--ink); font-weight: 500;">{c.aboutLink[lang]}</a>
      </div>
      <dl class="side dl reveal" style="flex-basis: 32rem;">
        {c.facts.map((f) => (<><dt>{f.k[lang]}</dt><dd>{f.v[lang]}</dd></>))}
      </dl>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap split">
      <h2 class="narrow-col reveal">{c.faqH2a[lang]}<br />{c.faqH2b[lang]}</h2>
      <div class="wide-col faq">
        {c.faq.map((f) => (
          <details>
            <summary>{f.q[lang]}</summary>
            <p>{f.a[lang]}</p>
            {'links' in f && f.links && f.links.map((l) => <p class="small"><a href={l.url} target="_blank" rel="noopener">{l.label[lang]}{'cite' in l && l.cite && <>{' — '}<bdi dir="ltr">{l.cite}</bdi></>}</a></p>)}
          </details>
        ))}
        <p class="small" style="margin-top: 1.5rem;"><time datetime="2026-11">{ui.reviewed[lang]}</time></p>
      </div>
    </div>
  </section>

  <section style="padding-bottom: clamp(4rem, 9vw, 7.5rem);">
    <div class="wrap">
      <div class="cta-band reveal">
        <div style="flex: 1 1 30rem; min-width: 0;">
          <h2>{c.ctaH2a[lang]}<br /><em style="color: var(--accent-light);">{c.ctaH2b[lang]}</em></h2>
          <p>{c.ctaText[lang]}</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-light" href={whatsappLink(whatsappMessages.secondOpinion[lang])}>{c.ctaBtn[lang]}</a>
          <a class="ulink" href={phone.tel}>{c.orCall[lang]} <bdi dir="ltr">{phone.intl}</bdi></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const box = document.getElementById('bmi');
  if (box) {
    const advice: string[] = JSON.parse(box.dataset.advice || '[]');
    const h = document.getElementById('bmi-h') as HTMLInputElement;
    const w = document.getElementById('bmi-w') as HTMLInputElement;
    const out = document.getElementById('bmi-out')!;
    const empty = document.getElementById('bmi-empty')!;
    const val = document.getElementById('bmi-val')!;
    const text = document.getElementById('bmi-advice')!;
    // Accept Arabic-Indic digits and Arabic or comma decimal separators.
    const num = (v: string) => {
      const s = v.replace(/[٠-٩]/g, (d) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(d))).replace('٫', '.').replace(',', '.');
      const n = parseFloat(s);
      return isFinite(n) ? n : 0;
    };
    const update = () => {
      const cm = num(h.value);
      const kg = num(w.value);
      const valid = cm >= 100 && cm <= 230 && kg >= 30 && kg <= 350;
      out.hidden = !valid;
      empty.hidden = valid;
      if (!valid) return;
      const bmi = kg / Math.pow(cm / 100, 2);
      val.textContent = bmi.toFixed(1);
      text.textContent = advice[bmi >= 35 ? 0 : bmi >= 30 ? 1 : bmi >= 25 ? 2 : 3];
    };
    h.addEventListener('input', update);
    w.addEventListener('input', update);
  }
</script>
