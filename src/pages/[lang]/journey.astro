---
import PageHero from '../../components/PageHero.astro';
import ContactBox from '../../components/ContactBox.astro';
import Base from '../../layouts/Base.astro';
import { langPaths, ui, type Lang } from '../../data/site';
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;

const c = {
  title: { en: 'Your Journey', ar: 'رحلتك العلاجية' },
  description: {
    en: 'What to expect from first contact to long-term follow-up with Dr. Alaa Alhazmi.',
    ar: 'ما يمكن توقعه من أول تواصل حتى المتابعة طويلة الأمد مع د. علاء الحازمي.',
  },
  intro: {
    en: 'Here is what to expect at each step, from your first message to long-term follow-up.',
    ar: 'إليك ما يمكن توقعه في كل خطوة، من رسالتك الأولى حتى المتابعة طويلة الأمد.',
  },
  steps: [
    { t: { en: 'Get in touch', ar: 'تواصل معنا' }, d: { en: 'Send a WhatsApp message or call to reach the team.', ar: 'أرسل رسالة عبر واتساب أو اتصل للتواصل مع الفريق.' } },
    { t: { en: 'Consultation', ar: 'الاستشارة' }, d: { en: 'Meet Dr. Alhazmi to review your history, goals and options. Bring any reports, test results and a list of your medicines.', ar: 'قابل د. علاء الحازمي لمراجعة تاريخك الصحي وأهدافك وخياراتك. أحضر ما لديك من تقارير ونتائج فحوصات وقائمة بأدويتك.' } },
    { t: { en: 'Assessment', ar: 'التقييم' }, d: { en: 'Tests and reviews by the team, such as nutrition, and other specialists when needed.', ar: 'فحوصات ومراجعات من الفريق، مثل التغذية، ومن تخصصات أخرى عند الحاجة.' } },
    { t: { en: 'Your plan', ar: 'خطتك العلاجية' }, d: { en: 'A clear plan, surgical or medical, with time to ask questions before you decide.', ar: 'خطة واضحة، جراحية أو طبية، مع وقت كافٍ لطرح أسئلتك قبل اتخاذ القرار.' } },
    { t: { en: 'Treatment', ar: 'العلاج' }, d: { en: 'Your operation or the start of your medical treatment, with instructions for preparing and recovering.', ar: 'إجراء العملية أو بدء العلاج الطبي، مع تعليمات للتهيئة والتعافي.' } },
    { t: { en: 'Follow-up', ar: 'المتابعة' }, d: { en: 'Regular follow-up visits to support your progress over the long term.', ar: 'زيارات متابعة منتظمة لدعم تقدمك على المدى الطويل.' } },
  ],
  faqTitle: { en: 'Common questions', ar: 'أسئلة شائعة' },
  faq: [
    {
      q: { en: 'Do I need a referral?', ar: 'هل أحتاج إلى إحالة؟' },
      a: { en: 'No. You can contact the team directly by WhatsApp or phone.', ar: 'لا. يمكنك التواصل مع الفريق مباشرة عبر واتساب أو الهاتف.' },
    },
    {
      q: { en: 'Is surgery the only option for obesity?', ar: 'هل الجراحة هي الخيار الوحيد لعلاج السمنة؟' },
      a: { en: 'No. Many people do well with a medical plan that may include nutrition, activity and medicines. Your options are discussed at your consultation.', ar: 'لا. يحقق كثيرون نتائج جيدة بخطة علاجية طبية قد تشمل التغذية والنشاط البدني والأدوية. وتُناقَش خياراتك خلال الاستشارة.' },
    },
    {
      q: { en: 'I live outside Riyadh or outside Saudi Arabia. Can I still be seen?', ar: 'أسكن خارج الرياض أو خارج المملكة. هل يمكنني المراجعة؟' },
      a: { en: 'Send a WhatsApp message to +966 50 970 4040 and the team will explain the options available to you.', ar: 'أرسل رسالة عبر واتساب إلى ‎+966 50 970 4040 وسيوضح لك الفريق الخيارات المتاحة.' },
    },
    {
      q: { en: 'Who answers when I call?', ar: 'من يردّ عند الاتصال؟' },
      a: { en: 'Calls are answered by Faisal, Dr. Alhazmi’s AI assistant, who takes your message so the team can get back to you. For faster replies, use WhatsApp.', ar: 'يردّ على الاتصالات فيصل، مساعد الذكاء الاصطناعي للدكتور علاء الحازمي، ويسجّل رسالتك ليتواصل معك الفريق. وللرد الأسرع استخدم واتساب.' },
    },
  ],
};
---
<Base lang={lang} path="journey" title={c.title} description={c.description}>
  <PageHero lang={lang} path="journey" title={c.title} lead={c.intro} />
  <section class="sec" aria-label={c.title[lang]}>
    <div class="wrap">
      <ol class="steps steps-6">
        {c.steps.map((s) => <li><h2 class="step-t">{s.t[lang]}</h2><p>{s.d[lang]}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="sec sec-sand" aria-labelledby="jfaq-h">
    <div class="wrap grid">
      <div class="faq-side"><h2 id="jfaq-h">{c.faqTitle[lang]}</h2></div>
      <div class="faq">
        <div class="faq-list">
          {c.faq.map((f) => (
            <details>
              <summary><span class="q">{f.q[lang]}</span><span class="pm" aria-hidden="true"></span></summary>
              <div class="a"><p>{f.a[lang]}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
  <ContactBox lang={lang} title={ui.discuss} />
</Base>
