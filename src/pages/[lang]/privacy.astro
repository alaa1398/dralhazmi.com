---
import Base from '../../layouts/Base.astro';
import { langPaths, ui, phone, type Lang } from '../../data/site';
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;

const c = {
  title: { en: 'Privacy', ar: 'الخصوصية' },
  description: {
    en: 'How information is handled on dralhazmi.com and when you contact Dr. Alaa Alhazmi.',
    ar: 'كيفية التعامل مع المعلومات في موقع dralhazmi.com وعند تواصلك مع د. علاء الحازمي.',
  },
  updated: { en: 'Effective 9 November 2026', ar: 'سارية من 9 نوفمبر 2026' },
  intro: {
    en: 'This notice explains how personal information is handled on this website and when you contact Dr. Alaa Alhazmi, in line with Saudi Arabia’s Personal Data Protection Law (PDPL).',
    ar: 'توضح هذه السياسة كيفية التعامل مع المعلومات الشخصية في هذا الموقع وعند تواصلك مع د. علاء الحازمي، وفق نظام حماية البيانات الشخصية في المملكة العربية السعودية.',
  },
  sections: [
    {
      h: { en: 'Who is responsible', ar: 'الجهة المسؤولة' },
      p: {
        en: 'Dr. Alaa Alhazmi is responsible for the personal information described here. You can reach us on WhatsApp or by phone at +966 50 970 4040.',
        ar: 'د. علاء الحازمي هو المسؤول عن المعلومات الشخصية الموضحة هنا. ويمكنك التواصل معنا عبر واتساب أو الهاتف على الرقم ‎+966 50 970 4040.',
      },
    },
    {
      h: { en: 'This website', ar: 'هذا الموقع' },
      p: {
        en: 'This website has no forms, accounts, advertising or tracking cookies, and we do not use it to collect personal information. The BMI calculator works entirely in your browser; the numbers you enter are not sent or stored. As with any website, our hosting and domain providers (GitHub and Cloudflare) may receive technical data such as your IP address to deliver the pages and keep them secure. Fonts load from this website, not from third parties.',
        ar: 'لا يحتوي هذا الموقع على نماذج أو حسابات أو إعلانات أو ملفات تعريف ارتباط للتتبع، ولا نستخدمه لجمع المعلومات الشخصية. وتعمل حاسبة مؤشر كتلة الجسم داخل متصفحك فقط، ولا تُرسَل الأرقام التي تدخلها ولا تُحفَظ. وكما في أي موقع، قد يتلقى مزوّدا الاستضافة والنطاق (GitHub وCloudflare) بيانات تقنية مثل عنوان IP الخاص بك لعرض الصفحات وحمايتها. وتُحمَّل الخطوط من الموقع نفسه وليس من جهات خارجية.',
      },
    },
    {
      h: { en: 'When you message or call us', ar: 'عند مراسلتنا أو الاتصال بنا' },
      p: {
        en: 'We receive the information you choose to share, usually your name, phone number and question. Your phone number is needed so we can reply; everything else is optional, but without it we may not be able to help with your request. We use this information only to respond to you and arrange the care you ask for, and we rely on your consent to do so. Calls are answered by Faisal, an AI assistant, who records your message for the team.',
        ar: 'نتلقى المعلومات التي تختار مشاركتها، وعادةً ما تكون اسمك ورقم هاتفك وسؤالك. ونحتاج إلى رقم هاتفك لنتمكن من الرد عليك، أما بقية المعلومات فاختيارية، لكن قد لا نتمكن من مساعدتك في طلبك من دونها. ونستخدم هذه المعلومات فقط للرد عليك وترتيب الرعاية التي تطلبها، بناءً على موافقتك. ويردّ على الاتصالات فيصل، وهو مساعد يعمل بالذكاء الاصطناعي يسجّل رسالتك للفريق.',
      },
    },
    {
      h: { en: 'Health information', ar: 'المعلومات الصحية' },
      p: {
        en: 'Health information is sensitive personal data under the PDPL. Please don’t send medical reports, images or other health details unless we ask. If we need them to answer you, we will first ask for your explicit consent and explain how they will be handled.',
        ar: 'تُعد المعلومات الصحية بيانات شخصية حساسة بموجب النظام. لذا يُرجى عدم إرسال تقارير أو صور طبية أو تفاصيل صحية أخرى ما لم نطلبها. وإن احتجنا إليها للرد عليك، فسنطلب موافقتك الصريحة أولًا ونوضح لك كيفية التعامل معها.',
      },
    },
    {
      h: { en: 'Who sees it and where it is processed', ar: 'من يطّلع عليها وأين تُعالَج' },
      p: {
        en: 'Only Dr. Alhazmi and authorized team members see your information. We do not sell it or use it for advertising, and we do not disclose it to anyone else unless the law requires it. WhatsApp (Meta Platforms) and the services that run Faisal (Anthropic, ElevenLabs and Notion) carry and process these messages and calls, and may do so outside Saudi Arabia.',
        ar: 'لا يطّلع على معلوماتك إلا د. علاء الحازمي وأعضاء الفريق المخوّلون. ولا نبيعها ولا نستخدمها لأغراض إعلانية، ولا نفصح عنها لأي جهة أخرى إلا إذا اقتضى النظام ذلك. وتتولى خدمة واتساب (شركة Meta Platforms) والخدمات التي يعمل عليها فيصل (Anthropic وElevenLabs وNotion) نقل هذه الرسائل والاتصالات ومعالجتها، وقد يتم ذلك خارج المملكة العربية السعودية.',
      },
    },
    {
      h: { en: 'How long we keep it', ar: 'مدة الاحتفاظ بها' },
      p: {
        en: 'We keep your messages and call records only as long as needed to respond to your request and any follow-up, then delete them. We delete them sooner if you ask, unless the law requires us to keep them.',
        ar: 'نحتفظ برسائلك وسجلات اتصالاتك فقط طوال المدة اللازمة للرد على طلبك ومتابعته، ثم نحذفها. ونحذفها في وقت أقرب إذا طلبت ذلك، ما لم يُلزمنا النظام بالاحتفاظ بها.',
      },
    },
    {
      h: { en: 'Your rights', ar: 'حقوقك' },
      p: {
        en: 'Under the PDPL, you have the right to know how your information is used, to see it and get a copy, to ask us to correct or delete it, and to withdraw your consent at any time. Send your request on WhatsApp to +966 50 970 4040. If you are not satisfied with our response, you can file a complaint with the Saudi Data & AI Authority (SDAIA).',
        ar: 'بموجب النظام، يحق لك معرفة كيفية استخدام معلوماتك، والاطلاع عليها والحصول على نسخة منها، وطلب تصحيحها أو حذفها، وسحب موافقتك في أي وقت. أرسل طلبك عبر واتساب إلى ‎+966 50 970 4040. وإن لم تكن راضيًا عن ردنا، يمكنك تقديم شكوى إلى الهيئة السعودية للبيانات والذكاء الاصطناعي (سدايا).',
      },
    },
    {
      h: { en: 'Changes to this notice', ar: 'تعديل هذه السياسة' },
      p: {
        en: 'If we change this notice, we will update the date at the top of this page.',
        ar: 'إذا عدّلنا هذه السياسة، فسنحدّث التاريخ في أعلى هذه الصفحة.',
      },
    },
  ],
};
---
<Base lang={lang} path="privacy" title={c.title} description={c.description}>
  <section class="section">
    <div class="wrap" style="max-width: 780px;">
      <h1>{c.title[lang]}</h1>
      <p class="small">{c.updated[lang]}</p>
      <p class="lead">{c.intro[lang]}</p>
      {c.sections.map((s) => <><h2>{s.h[lang]}</h2><p>{s.p[lang]}</p></>)}
      <p class="small"><a href={phone.whatsapp}>{ui.whatsapp[lang]} <bdi dir="ltr">{phone.intl}</bdi></a></p>
    </div>
  </section>
</Base>
