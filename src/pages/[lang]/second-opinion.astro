---
import PageHero from '../../components/PageHero.astro';
import ContactBox from '../../components/ContactBox.astro';
import Wa from '../../components/Wa.astro';
import Base from '../../layouts/Base.astro';
import { langPaths, ui, phone, whatsappLink, whatsappMessages, type Lang } from '../../data/site';
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;

const c = {
  title: { en: 'Second Opinion', ar: 'رأي طبي ثانٍ' },
  description: {
    en: 'Second opinion from Dr. Alaa Alhazmi on bariatric, metabolic and general surgery questions, by WhatsApp.',
    ar: 'رأي طبي ثانٍ من د. علاء الحازمي في جراحات السمنة والجراحة الأيضية والعامة، عبر واتساب.',
  },
  intro: {
    en: 'If you already have a diagnosis or a recommendation for surgery, you can ask Dr. Alhazmi for a second opinion.',
    ar: 'إذا كان لديك تشخيص أو توصية بإجراء عملية، يمكنك طلب رأي طبي ثانٍ من د. علاء الحازمي.',
  },
  coversTitle: { en: 'What we can review', ar: 'ما يمكننا مراجعته' },
  covers: [
    { en: 'Bariatric and metabolic surgery, including revision of a previous operation', ar: 'جراحات السمنة والجراحة الأيضية، بما فيها تصحيح عملية سابقة' },
    { en: 'Gallbladder, hernia, reflux and other general surgery conditions', ar: 'المرارة والفتق والارتجاع وغيرها من حالات الجراحة العامة' },
    { en: 'Medical treatment options for obesity', ar: 'خيارات العلاج الطبي (غير الجراحي) للسمنة' },
  ],
  howTitle: { en: 'How it works', ar: 'كيف تعمل الخدمة' },
  how: [
    { en: 'Message us on WhatsApp with a short description of your question.', ar: 'راسلنا عبر واتساب بوصف مختصر لسؤالك.' },
    { en: 'Please don’t send medical reports or images in your first message. If they are needed, the team will ask for your consent first and explain how to share them.', ar: 'يُرجى عدم إرسال تقارير أو صور طبية في رسالتك الأولى. وإن احتاج الأمر إليها، فسيطلب الفريق موافقتك أولًا ويوضح لك طريقة مشاركتها.' },
    { en: 'Dr. Alhazmi replies on WhatsApp, or recommends a consultation if an examination is needed.', ar: 'يردّ د. علاء الحازمي عبر واتساب، أو يوصي باستشارة إن تطلّب الأمر فحصًا.' },
  ],
  limitsTitle: { en: 'Please note', ar: 'يُرجى الملاحظة' },
  limits: [
    { en: 'This service is not for emergencies. For a medical emergency, call 997 or go to the nearest emergency department.', ar: 'هذه الخدمة ليست للحالات الطارئة. في الحالات الطارئة، اتصل على 997 أو توجّه إلى أقرب قسم طوارئ.' },
    { en: 'A written opinion does not replace an examination. Dr. Alhazmi may recommend a consultation in person.', ar: 'الرأي المكتوب لا يغني عن الفحص السريري، وقد يوصي د. علاء الحازمي باستشارة حضورية.' },
    { en: 'See our privacy page for how your information is handled.', ar: 'اطّلع على صفحة الخصوصية لمعرفة كيفية التعامل مع معلوماتك.' },
  ],
  cta: { en: 'Request a second opinion', ar: 'اطلب رأيًا طبيًا ثانيًا' },
};
---
<Base lang={lang} path="second-opinion" title={c.title} description={c.description}>
  <PageHero lang={lang} path="second-opinion" title={c.title} lead={c.intro}>
    <div class="actions"><a class="btn" href={whatsappLink(whatsappMessages.secondOpinion[lang])}><Wa /><span>{c.cta[lang]}</span></a></div>
  </PageHero>
  <div class="chapters">
    <div class="wrap">
      <section class="chapter" aria-labelledby="ch-covers">
        <div class="ch-side"><p class="label ch-no num" aria-hidden="true">01</p><h2 id="ch-covers">{c.coversTitle[lang]}</h2></div>
        <div class="ch-body"><ul class="rule-list">{c.covers.map((x) => <li>{x[lang]}</li>)}</ul></div>
      </section>
      <section class="chapter" aria-labelledby="ch-how">
        <div class="ch-side"><p class="label ch-no num" aria-hidden="true">02</p><h2 id="ch-how">{c.howTitle[lang]}</h2></div>
        <div class="ch-body"><ol class="num-list">{c.how.map((x) => <li><span>{x[lang]}</span></li>)}</ol></div>
      </section>
      <section class="chapter" aria-labelledby="ch-limits">
        <div class="ch-side"><p class="label ch-no num" aria-hidden="true">03</p><h2 id="ch-limits">{c.limitsTitle[lang]}</h2></div>
        <div class="ch-body">
          <div class="callout" style="margin-block-start: 0;">
            {c.limits.map((x) => <p>{x[lang]}</p>)}
            <p><a class="tlink more" href={`/${lang}/privacy/`}>{ui.privacy[lang]}</a></p>
          </div>
        </div>
      </section>
    </div>
  </div>
  <ContactBox lang={lang} title={ui.discuss} secondOpinion button={c.cta}>
    <p class="small">{ui.whatsapp[lang]}: <bdi dir="ltr" class="num">{phone.intl}</bdi></p>
  </ContactBox>
</Base>
