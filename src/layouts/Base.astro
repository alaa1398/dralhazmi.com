---
import '../styles/global.css';
import { DRAFT, site, nav, ui, phone, faisalNote, whatsappLink, whatsappMessages, type Lang, type T } from '../data/site';
import Wa from '../components/Wa.astro';

interface Props {
  lang: Lang;
  path: string; // page path without language prefix, e.g. 'about' or ''
  title: T;
  description: T;
}
const { lang, path, title, description } = Astro.props;
const other: Lang = lang === 'en' ? 'ar' : 'en';
const href = (l: Lang, p: string) => `/${l}/${p ? p + '/' : ''}`;
const pageTitle = path ? `${title[lang]} | ${site.name[lang]}` : `${site.name[lang]} | ${site.title[lang]}`;
const current = path.split('/')[0];
const contact = whatsappLink(whatsappMessages.booking[lang]);
const footerLinks = [
  { path: 'resources', label: ui.resources },
  { path: 'links', label: ui.links },
  { path: 'privacy', label: ui.privacy },
];
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description[lang]} />
    {DRAFT && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={site.url + href(lang, path)} />
    <link rel="alternate" hreflang="en" href={site.url + href('en', path)} />
    <link rel="alternate" hreflang="ar" href={site.url + href('ar', path)} />
    <link rel="alternate" hreflang="x-default" href={site.url + '/'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name[lang]} />
    <meta property="og:url" content={site.url + href(lang, path)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description[lang]} />
    <meta property="og:image" content={site.url + '/images/og.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name[lang]} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_SA'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f8f5ef" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip[lang]}</a>
    {DRAFT && <div class="draft">{ui.draft[lang]}</div>}
    <header class="header">
      <div class="wrap header-row">
        <a class="brand" href={href(lang, '')}>
          <span class="brand-name">{site.name[lang]}</span>
          <span class="brand-sub">{ui.tagline[lang]}</span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav"><i aria-hidden="true"></i>{ui.menu[lang]}</button>
        <nav class="nav" id="nav" aria-label={ui.mainNav[lang]}>
          {nav.map((n) => (
            <a href={href(lang, n.path)} aria-current={n.path === current ? 'page' : undefined}>{n.label[lang]}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="lang-switch" href={href(other, path)} hreflang={other} lang={other}>{ui.switchLang[lang]}</a>
          <a class="btn btn-sm" href={contact}>{ui.contact[lang]}</a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <p class="colophon" aria-hidden="true">{site.name[lang]}</p>
        <p class="cred" dir="ltr" lang="en">{site.credentials}</p>
        <div class="footer-grid">
          <div class="footer-contact">
            <p class="footer-phone"><a href={phone.tel}><bdi dir="ltr" class="num">{phone.intl}</bdi></a></p>
            <a class="tlink more" href={contact}>{ui.bookWhatsApp[lang]}</a>
            <p class="small">{faisalNote[lang]}</p>
            <p class="small emergency">{ui.emergency[lang]}</p>
          </div>
          <nav class="footer-nav" aria-label={ui.footerNav[lang]}>
            <ul>
              {nav.map((n) => <li><a href={href(lang, n.path)}>{n.label[lang]}</a></li>)}
            </ul>
          </nav>
          <div class="footer-links">
            <ul>
              {footerLinks.map((n) => <li><a href={href(lang, n.path)}>{n.label[lang]}</a></li>)}
              <li><a href={href(other, path)} hreflang={other} lang={other}>{ui.switchLang[lang]}</a></li>
            </ul>
          </div>
        </div>
        <p class="small footer-legal"><span>© <span class="num">{new Date().getFullYear()}</span> {site.name[lang]}. {ui.rights[lang]}</span></p>
      </div>
    </footer>

    <aside class="contact-bar" aria-label={ui.contact[lang]}>
      <a class="btn wa" href={contact}><Wa /><span>{ui.whatsapp[lang]}</span></a>
      <a class="btn call" href={phone.tel}><span>{ui.call[lang]}</span> <bdi dir="ltr" class="num">{phone.intl}</bdi></a>
    </aside>
    <script is:inline>
      (function () {
        var b = document.querySelector('.menu-btn'), n = document.getElementById('nav');
        if (!b || !n) return;
        b.addEventListener('click', function () {
          var open = n.classList.toggle('open');
          b.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && n.classList.contains('open')) { n.classList.remove('open'); b.setAttribute('aria-expanded', 'false'); b.focus(); }
        });
      })();
    </script>
  </body>
</html>
