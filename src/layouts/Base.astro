---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/amiri/400.css';
import '@fontsource/amiri/700.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '../styles/global.css';
import { DRAFT, site, nav, ui, phone, faisalNote, whatsappLink, whatsappMessages, type Lang, type T } from '../data/site';

interface Props {
  lang: Lang;
  path: string; // page path without language prefix, e.g. 'about' or ''
  title: T;
  description: T;
}
const { lang, path, title, description } = Astro.props;
const other: Lang = lang === 'en' ? 'ar' : 'en';
const href = (l: Lang, p: string) => `/${l}/${p ? p + '/' : ''}`;
const pageTitle = path ? `${title[lang]} | ${site.name[lang]}` : `${site.name[lang]} | ${site.title[lang]}`;
const current = path.split('/')[0];
const brandTitle = { en: 'Robotic & Bariatric Surgery', ar: 'الجراحة الروبوتية وجراحة السمنة' };
const book = { en: 'Contact', ar: 'تواصل معنا' };
const skip = { en: 'Skip to main content', ar: 'انتقل إلى المحتوى الرئيسي' };
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description[lang]} />
    {DRAFT && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={site.url + href(lang, path)} />
    <link rel="alternate" hreflang="en" href={site.url + href('en', path)} />
    <link rel="alternate" hreflang="ar" href={site.url + href('ar', path)} />
    <link rel="alternate" hreflang="x-default" href={site.url + '/'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description[lang]} />
    <meta property="og:image" content={site.url + '/images/og.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{skip[lang]}</a>
    {DRAFT && <div class="draft">{ui.draft[lang]}</div>}
    <header class="header">
      <div class="wrap header-row">
        <a class="brand" href={href(lang, '')}>
          <span class="monogram" aria-hidden="true">AH</span>
          <span class="brand-text">
            <span class="brand-name">{site.name[lang]}</span>
            <span class="brand-title">{brandTitle[lang]}</span>
          </span>
        </a>
        <div class="header-contact">
          <a class="lang ulink" href={href(other, path)} hreflang={other} lang={other}>{ui.switchLang[lang]}</a>
          <a class="btn btn-primary btn-sm" href={whatsappLink(whatsappMessages.booking[lang])}>{book[lang]}</a>
        </div>
      </div>
      <nav class="wrap nav" aria-label="Main">
        {nav.map((n) => (
          <a class="ulink" href={href(lang, n.path)} aria-current={n.path === current ? 'page' : undefined}>{n.label[lang]}</a>
        ))}
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <span class="monogram" aria-hidden="true">AH</span>
          <div>
            <p class="footer-name">{site.name[lang]}</p>
            <p dir="ltr" style={lang === 'ar' ? 'text-align: right;' : undefined}>{site.credentials}</p>
          </div>
        </div>
        <div>
          <p class="footer-phone"><a class="ulink" href={phone.tel}><bdi dir="ltr">{phone.intl}</bdi></a></p>
          <p class="small">{faisalNote[lang]}</p>
          <p class="small">{ui.emergency[lang]}</p>
        </div>
        <div>
          <p><a class="ulink" href={href(lang, 'resources')}>{ui.resources[lang]}</a></p>
          <p><a class="ulink" href={href(lang, 'links')}>{ui.links[lang]}</a></p>
          <p><a class="ulink" href={href(lang, 'privacy')}>{ui.privacy[lang]}</a></p>
          <p class="small">© {new Date().getFullYear()} {site.name[lang]}. {ui.rights[lang]}</p>
        </div>
      </div>
    </footer>

    <div class="contact-bar" aria-label="Contact">
      <a class="btn btn-wa" href={whatsappLink(whatsappMessages.booking[lang])}>{ui.whatsapp[lang]}</a>
      <a class="btn btn-call" href={phone.tel}>{ui.call[lang]} <bdi dir="ltr">{phone.intl}</bdi></a>
    </div>
  </body>
</html>
