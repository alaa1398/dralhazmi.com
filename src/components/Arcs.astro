---
// Abstract line drawing: concentric arcs and two instrument paths. Decoration only.
const radii = [90, 150, 210, 270, 330, 390, 450, 510, 570];
---
<svg class="arcs" viewBox="0 0 600 600" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1">
  <g opacity=".16">{radii.map((r) => <circle cx="600" cy="0" r={r} vector-effect="non-scaling-stroke" />)}</g>
  <g opacity=".5"><path d="M600 0 276 324" vector-effect="non-scaling-stroke" /><path d="M600 0 121 204" vector-effect="non-scaling-stroke" opacity=".5" /></g>
  <g class="pin" opacity=".9"><circle cx="276" cy="324" r="5" vector-effect="non-scaling-stroke" /><circle cx="121" cy="204" r="3" vector-effect="non-scaling-stroke" /></g>
</svg>
